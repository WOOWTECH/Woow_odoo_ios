#include "Shared.xcconfig"
APP_BRAND = woowtech
APP_DISPLAY_NAME = woowtech platform
PRODUCT_BUNDLE_IDENTIFIER = io.woowtech.odoo
APP_URL_SCHEME = woowodoo
// WOOW 1.0 (4) is already published. The parity release must use a new
// marketing/build pair so an archive can never overwrite or reuse a store build.
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 5
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_ENTITLEMENTS = odoo/odoo.entitlements
BRAND_RELEASE_AUDIT = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
FIREBASE_CONFIG_PATH = $(SRCROOT)/odoo/GoogleService-Info.plist
FIREBASE_EXPECTED_PROJECT_ID = woow-odoo-de2cb
