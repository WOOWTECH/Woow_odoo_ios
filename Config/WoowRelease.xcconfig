#include "Shared.xcconfig"
APP_BRAND = woowtech
APP_DISPLAY_NAME = woowtech platform
PRODUCT_BUNDLE_IDENTIFIER = io.woowtech.odoo
APP_URL_SCHEME = woowodoo
CURRENT_PROJECT_VERSION = 3
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_ENTITLEMENTS = odoo/odoo-Release.entitlements
BRAND_RELEASE_AUDIT = YES
// Release never ships coverage instrumentation (audit_release_archive.sh, run by
// the in-build Release audit phase, rejects it). A scheme whose test plan gathers
// coverage injects CLANG_COVERAGE_MAPPING=YES into the build action ABOVE xcconfig
// precedence, so the NO below only covers non-scheme builds; the gates the
// compilers/linker actually consult are: Swift -profile-generate
// (ENABLE_CODE_COVERAGE), Clang -fprofile-instr-generate (CLANG_ENABLE_CODE_COVERAGE),
// link-time profile runtime (CLANG_COVERAGE_MAPPING_LINKER_ARGS) and ld
// -debug_variant, which would silence customer-binary warnings (LD_DEBUG_VARIANT).
// LIMIT: Swift package targets (Firebase etc.) never read this file; a scheme
// build still instruments them, so a Release `xcodebuild build -scheme ...` must
// also pass CLANG_COVERAGE_MAPPING=NO on the command line (applies to all targets).
CLANG_COVERAGE_MAPPING = NO
ENABLE_CODE_COVERAGE = NO
CLANG_ENABLE_CODE_COVERAGE = NO
CLANG_COVERAGE_MAPPING_LINKER_ARGS = NO
LD_DEBUG_VARIANT = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = 
FIREBASE_CONFIG_PATH = $(SRCROOT)/odoo/GoogleService-Info.plist
FIREBASE_EXPECTED_PROJECT_ID = woow-odoo-de2cb
